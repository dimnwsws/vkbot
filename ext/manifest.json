{
  "manifest_version": 2,
  "name": "VK Message Monitor",
  "version": "1.0",
  "description": "Monitors VK group chat messages for specific keywords and responds automatically",
  "permissions": [
    "storage",
    "tabs",
    "*://*.vk.com/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["*://*.vk.com/*"],
      "js": ["content.js"]
    }
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
